# Environment variables for recipe_app_frontend

# Backend base URL. If unset or empty, app uses in-memory mock service.
# Example: http://localhost:8080
VITE_API_BASE=

# Alternative backend URL key (if used by your environment). Optional.
VITE_BACKEND_URL=

# Environment mode (development/production). If development and no VITE_API_BASE, mock is used.
VITE_NODE_ENV=development

# Frontend/site URL (optional; may be used by auth flows if added later)
VITE_FRONTEND_URL=
VITE_WS_URL=
VITE_PORT=3000
VITE_LOG_LEVEL=info
VITE_HEALTHCHECK_PATH=/healthz
VITE_FEATURE_FLAGS=
VITE_EXPERIMENTS_ENABLED=
VITE_TRUST_PROXY=0
VITE_NEXT_TELEMETRY_DISABLED=1
VITE_ENABLE_SOURCE_MAPS=0
